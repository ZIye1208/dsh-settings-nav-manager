{
  "name": "dsh-settings-nav-manager",
  "version": "1.0.1",
  "private": false,
  "license": "MIT",
  "description": "DSH 设置页导航管理插件 —— 拖拽排序 · 显隐 · 抽屉收纳 · 持久化",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIye1208/dsh-settings-nav-manager.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/demo.gif",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs test/repo.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "locale": "node tools/gen-locale.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0",
      "node": ">=20.18",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "engines": {
    "node": ">=20.18"
  }
}
